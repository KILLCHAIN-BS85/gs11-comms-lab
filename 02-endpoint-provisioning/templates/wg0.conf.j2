# WireGuard configuration — generated by Ansible
# Device: {{ device_id }} | Role: {{ device_role }}
# Generated: {{ ansible_date_time.iso8601 }}

[Interface]
Address = {{ wg_address_prefix }}.{{ hostvars[inventory_hostname]['ansible_host'].split('.')[-1] }}/24
PrivateKey = {{ wg_private_key.stdout }}
DNS = {{ dns_servers | join(', ') }}
MTU = 1420

[Peer]
# WireGuard Hub (monitoring server / gateway)
PublicKey = {{ hostvars['monitoring']['wg_public_key']['stdout'] | default('REPLACE_WITH_SERVER_PUBKEY') }}
Endpoint = {{ wireguard_server_ip }}:{{ wireguard_port }}
AllowedIPs = 10.99.0.0/24, 10.45.0.0/16, 10.46.0.0/16
PersistentKeepalive = 25
